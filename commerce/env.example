# Backend only. Never include this file with real secrets in the Mac app.
HOST=127.0.0.1
PORT=8789
WSN_PUBLIC_ORIGIN=https://your-selected-domain.example
WSN_SALES_ENABLED=false
WSN_DATA_DIR=./data
WSN_SIGNING_KEY_FILE=./private/license-private.pem
VOICE_BANK_BIN=TPB
VOICE_BANK_ACCOUNT=55111685555
VOICE_BANK_NAME=BUI QUOC HUNG
QR_PROJECT_ID=windi-sach-noi
QR_CODE_PREFIX=WSN
QR_CODE_LENGTH=10
QR_API_KEY=
# SePay API Access token: required by the current device Edge Function to verify bank receipts.
# Merely displaying a QR does not require a token. Never expose this in the app/browser.
SEPAY_API_TOKEN=
# Separate shared key configured on the SePay webhook (Authorization: Apikey ...).
SEPAY_WEBHOOK_API_KEY=
# Optional payment PostgreSQL; accounts still require a persistent single-server disk.
# QR_DATABASE_URL=

# Device QR / Supabase Edge Functions (current flow; backend only).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=  # deployment only; never put in the app/browser
# SEPAY_API_TOKEN is REQUIRED for bank API verification in the device flow.
# API token and webhook API Key are different credentials.

# Per-book Pro Cloud, SERVER/OWNER ONLY. Leave disabled before rights/deployment approval.
WSN_BOOKS_ENABLED=false
WSN_BOOKS_COMMERCIAL_RIGHTS_CONFIRMED=false
WSN_BANK_BIN=970423
WSN_BANK_NAME=TPBank
WSN_BANK_HOLDER=
# WSN_BANK_ACCOUNT=  # same receiving account verified by SePay
WSN_MODAL_BATCH_URL=
WSN_MODAL_PROXY_KEY=
WSN_MODAL_PROXY_SECRET=
# Development app only: WSN_BOOKS_API=https://<selected-host>/functions/v1/wsn-books

# Mac paid book activation (server only, after owner rights + bank/webhook verification).
WSN_PAYMENTS_READY=false
WSN_HEYGEN_PAID_ENABLED=false
# Use commerce/paid-cloud-deploy.mjs; never copy merchant credentials into the app.
