{
  "name": "soundbooki-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page tiếng Việt cho Soundbooki, độc lập với app Mac và Android.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dir dist",
    "check": "node scripts/check.mjs",
    "build:scene": "esbuild scene.js --bundle --minify --format=iife --global-name=SoundbookiScene --legal-comments=inline --outfile=assets/vendor/book-scene.js"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
