# Server-only. Never use NEXT_PUBLIC_* / VITE_* for either secret.
QR_BANK_BIN=970422
QR_BANK_ACCOUNT=YOUR_BANK_ACCOUNT
QR_BANK_NAME=YOUR ACCOUNT NAME
# SePay webhook authentication API Key, NOT the SePay user API Bearer token.
SEPAY_WEBHOOK_API_KEY=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
# Separate key for calls from your project's backend to create/check orders.
QR_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_32_CHARS_MINIMUM
QR_CODE_PREFIX=WD
# 6 gives WD029292; 10 is recommended for a larger collision-free lifetime space.
QR_CODE_LENGTH=10
QR_CODE_CHARSET=digits
QR_ORDER_TTL_SECONDS=900
QR_PROJECT_ID=my-project
# VPS/local: auto-created SQLite file. Mount this directory as persistent storage.
QR_SQLITE_PATH=./data/qr-payments.sqlite
# PostgreSQL/serverless: set this to override SQLite. Tables are created automatically.
# QR_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
HOST=127.0.0.1
PORT=8787
